# Copy to .env and fill in what you use. Nothing here is required to run the tests.

# Muse Spark on the Meta Model API: labels and steering judgments
META_API_KEY=

# Where the runs (SAEs, catalogs, labels, steering results) live on a workstation
GLIMMER_RUNS=runs

# A JSON file with your own safety patterns (see scope/safety.py). Without it nothing is screened or flagged.
GLIMMER_SAFETY_PATTERNS=

# A local model behind an OpenAI-compatible endpoint, for what Spark should not see
LOCAL_LLM_URL=http://localhost:8080/v1/chat/completions
LOCAL_LLM_MODEL=local-model

# The S3 bucket a GPU box syncs its runs to
GLIMMER_BUCKET=
