 common/common.h                 |   1 +
 tools/server/server-context.cpp | 133 +++++++++++++++++++++++++++++++-
 tools/server/server-context.h   |   4 +
 tools/server/server-schema.cpp  |  31 ++++++++
 tools/server/server-task.cpp    |  10 +++
 tools/server/server-task.h      |   1 +
