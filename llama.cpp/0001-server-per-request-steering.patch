     }
 
     // returns -1 if the generation is limitless
@@ -1034,6 +1038,101 @@ private:
 
     json json_ui_settings = json::object();
 
+    // control vectors that requests mix by name with a "steering" field, from --steering-dir
+    std::map<std::string, common_control_vector_data> steering_vectors;
+    common_control_vector_data steering_base = { -1, {} }; // from --control-vector, kept under every mix
+    std::map<std::string, float> steering_active;          // the mix the context holds now
+    json steering_info = json::object();
+
+    void load_steering(const std::string & dir) {
+        namespace fs = std::filesystem;
+        const int32_t n_embd = llama_model_n_embd(model_tgt);
+
+        json labels = json::object();
+        const fs::path labels_path = fs::path(dir) / "steering.json";
+        if (fs::exists(labels_path)) {
+            try {
+                std::ifstream f(labels_path);
+                labels = json::parse(std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>()));
+            } catch (const std::exception & e) {
+                SRV_WRN("ignoring %s: %s\n", labels_path.string().c_str(), e.what());
+            }
+        }
+
+        std::vector<fs::path> files;
+        for (const auto & entry : fs::directory_iterator(dir)) {
+            if (entry.is_regular_file() && entry.path().extension() == ".gguf") {
+                files.push_back(entry.path());
+            }
+        }
+        std::sort(files.begin(), files.end());
+
+        json vectors = json::array();
+        for (const auto & path : files) {
+            auto data = common_control_vector_load({ { 1.0f, path.string() } });
+            if (data.n_embd != n_embd) {
+                SRV_WRN("skipping steering vector %s: width %d, model has %d\n", path.string().c_str(), data.n_embd, n_embd);
+                continue;
+            }
+            const std::string name = path.stem().string();
+            steering_vectors[name] = std::move(data);
+            json info = { { "name", name } };
+            if (labels.is_object() && labels.contains(name) && labels.at(name).is_object()) {
+                for (const auto & [key, value] : labels.at(name).items()) {
+                    info[key] = value;
+                }
+            }
+            vectors.push_back(info);
+        }
+
+        if (!params_base.control_vectors.empty()) {
+            steering_base = common_control_vector_load(params_base.control_vectors);
+        }
+        steering_info = { { "vectors", vectors } };
+        SRV_INF("loaded %zu steering vectors from %s\n", steering_vectors.size(), dir.c_str());
+    }
+
+    // set the context's control vector to the base plus this mix, only when it changes
+    void apply_steering(const std::map<std::string, float> & mix) {
+        if (steering_vectors.empty() || mix == steering_active) {
+            return;
+        }
+        const int32_t n_embd  = llama_model_n_embd(model_tgt);
+        const int32_t n_layer = llama_model_n_layer(model_tgt);
+
+        // a buffer for every layer, so whatever the last mix touched is zeroed too
+        std::vector<float> data((size_t) n_embd * (n_layer - 1), 0.0f);
+        auto add_vector = [&](const common_control_vector_data & v, float strength) {
+            const size_t n = std::min(v.data.size(), data.size());
+            for (size_t i = 0; i < n; ++i) {
+                data[i] += strength * v.data[i];
+            }
+        };
+        if (steering_base.n_embd == n_embd) {
+            add_vector(steering_base, 1.0f);
+        }
+        for (const auto & [name, strength] : mix) {
+            add_vector(steering_vectors.at(name), strength);
+        }
+
+        // only the layers that carry a direction go into the graph
+        int32_t il_start = -1;
+        int32_t il_end   = -1;
+        for (int32_t il = 1; il < n_layer; ++il) {
+            const float * row = data.data() + (size_t) n_embd * (il - 1);
+            if (std::any_of(row, row + n_embd, [](float x) { return x != 0.0f; })) {
+                il_start = il_start < 0 ? il : il_start;
+                il_end   = il;
+            }
+        }
+        if (il_start < 0) {
+            llama_set_adapter_cvec(ctx_tgt, nullptr, 0, n_embd, -1, -1);
+        } else {
+            llama_set_adapter_cvec(ctx_tgt, data.data(), data.size(), n_embd, il_start, il_end);
+        }
+        steering_active = mix;
+    }
+
     // Necessary similarity of prompt for slot selection
     float slot_prompt_similarity = 0.0f;
 
@@ -1490,6 +1589,16 @@ private:
             batch.init(ctx_tgt, std::max(n_batch, params_base.n_parallel), n_embd);
         }
 
+        if (!params_base.steering_dir.empty()) {
+            load_steering(params_base.steering_dir);
+            // cached prompts would come back computed under whatever mix made them
+            if (params_base.cache_ram_mib != 0) {
+                SRV_INF("%s", "steering: RAM prompt cache disabled\n");
+            }
+            params_base.cache_ram_mib    = 0;
+            params_base.cache_idle_slots = false;
+        }
+
         // decision requests rarely repeat a state, the prompt cache is opt-in for decision models
         if (decision.type != COMMON_DECISION_TYPE_NONE && !params_base.cache_ram_explicit) {
             SRV_INF("%s", "decision model: prompt cache disabled by default, use `--cache-ram N` to enable it\n");
@@ -1848,6 +1957,20 @@ private:
     }
 
     bool launch_slot_with_task(server_slot & slot, server_task && task) {
+        for (const auto & [name, strength] : task.params.steering) {
+            if (steering_vectors.find(name) == steering_vectors.end()) {
+                send_error(task, steering_vectors.empty() ? std::string("steering needs --steering-dir") : "unknown steering vector: " + name,
+                           ERROR_TYPE_INVALID_REQUEST);
+                return false;
+            }
+        }
+        if (task.params.steering != slot.steering) {
+            // the cached prompt was computed under another mix
+            SLT_INF(slot, "clearing cache for steering change, %zu -> %zu vectors\n", slot.steering.size(), task.params.steering.size());
+            slot.prompt_clear();
+            slot.steering = task.params.steering;
+        }
+
         // process per-request lora adapters
         if (!task.params.lora.empty()) {
             auto task_loras = construct_lora_list(task.params.lora);
@@ -3315,6 +3438,7 @@ private:
             // TODO @ngxson : alora handling is too messy, need to refactor it to be more clear and maintainable
             // apply lora, only need to do it once per batch
             common_set_adapter_lora(ctx_tgt, slot_batched->lora);
+            apply_steering(slot_batched->steering);
 
             // if the lora is temporarily disabled for an alora, re-enable it
             // for next time
@@ -4847,6 +4971,7 @@ server_context_meta server_context::get_meta() const {
         /* model_n_params          */ llama_model_n_params(impl->model_tgt),
         /* model_size              */ llama_model_size(impl->model_tgt),
         /* model_ftype             */ ftype_name,
+        /* steering                */ impl->steering_info,
     };
 }
 
@@ -5440,6 +5565,12 @@ void server_routes::init_routes() {
         return res;
     };
 
+    this->get_steering = [this](const server_http_req &) {
+        auto res = create_response(true);
+        res->ok(meta->steering);
+        return res;
+    };
+
     this->post_props = [this](const server_http_req &) {
         auto res = create_response();
         if (!params.endpoint_props) {
