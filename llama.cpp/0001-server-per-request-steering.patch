     json get_model_info() const;
diff --git a/tools/server/server-schema.cpp b/tools/server/server-schema.cpp
index 54e126aa0..d15329cb5 100644
--- a/tools/server/server-schema.cpp
+++ b/tools/server/server-schema.cpp
@@ -236,6 +236,37 @@ std::vector<std::unique_ptr<field>> make_llama_cmpl_schema(const common_params &
             ctx.params.lora = parse_lora_request(lora);
         }));
 
+    add((new field_json("steering"))
+        ->set_desc("Control vectors from --steering-dir to add for this request: an object of name -> strength, or an array of {name, strength}. Vectors not listed are off")
+        ->set_handler([&](field_eval_context & ctx, const json & data) {
+            const auto & steering = data.at("steering");
+            std::map<std::string, float> mix;
+            auto add_vector = [&](const std::string & name, const json & strength) {
+                if (!strength.is_number()) {
+                    throw std::runtime_error("Error: steering strengths must be numbers");
+                }
+                const float value = strength.get<float>();
+                if (value != 0.0f) {
+                    mix[name] += value;
+                }
+            };
+            if (steering.is_object()) {
+                for (const auto & [name, strength] : steering.items()) {
+                    add_vector(name, strength);
+                }
+            } else if (steering.is_array()) {
+                for (const auto & item : steering) {
+                    if (!item.is_object() || !item.contains("name") || !item.at("name").is_string()) {
+                        throw std::runtime_error("Error: each steering entry needs a string 'name' and a numeric 'strength'");
+                    }
+                    add_vector(item.at("name").get<std::string>(), item.value("strength", json(0.0)));
+                }
+            } else if (!steering.is_null()) {
+                throw std::runtime_error("Error: 'steering' must be an object of name -> strength or an array of {name, strength}");
+            }
+            ctx.params.steering = std::move(mix);
+        }));
+
     // sequence breakers for DRY
     // Currently, this is not compatible with TextGen WebUI, Koboldcpp and SillyTavern format
     // Ref: https://github.com/oobabooga/text-generation-webui/blob/d1af7a41ade7bd3c3a463bfa640725edb818ebaf/extensions/openai/typing.py#L39
diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index 3f30da2cd..59367c7ac 100644
--- a/tools/server/server-task.cpp
+++ b/tools/server/server-task.cpp
@@ -27,6 +27,14 @@ json task_params::format_logit_bias(const std::vector<llama_logit_bias> & logit_
     return data;
 }
 
+static json steering_to_json(const std::map<std::string, float> & mix) {
+    json out = json::object();
+    for (const auto & [name, strength] : mix) {
+        out[name] = strength;
+    }
+    return out;
+}
+
 json task_params::to_json(bool only_metrics) const {
     std::vector<std::string> samplers;
     samplers.reserve(sampling.samplers.size());
@@ -83,6 +91,7 @@ json task_params::to_json(bool only_metrics) const {
             {"post_sampling_probs",       post_sampling_probs},
             {"backend_sampling",          sampling.backend_sampling},
             {"lora",                      lora},
+            {"steering",                  steering_to_json(steering)},
         };
     }
 
@@ -142,6 +151,7 @@ json task_params::to_json(bool only_metrics) const {
         {"post_sampling_probs",       post_sampling_probs},
         {"backend_sampling",          sampling.backend_sampling},
         {"lora",                      lora},
+        {"steering",                  steering_to_json(steering)},
     };
 }
 
